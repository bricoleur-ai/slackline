# slackline configuration — copy to .env and edit. Never commit .env.
# This file is consumed by docker-compose.yml (the Docker deploy). It is NOT read by a
# bare-metal `node standalone.mjs` run or by the systemd ingest daemon — those take config
# from the process environment directly, or from ~/.slackline/bridge.env.
#
# ── required: set these before first run ──────────────────────────────
SLACKLINE_SECRET=change-me-to-a-long-random-string   # gates every API route; collectors + subscribers present it
PGPASSWORD=change-me-strong-db-password              # Postgres password (compose creates the DB with it)

# ── optional: which image to run ───────────────────────────────────────
# SLACKLINE_IMAGE=ghcr.io/bricoleur-ai/slackline:latest   # default shown; pin a tag (:1.2.3 or :<sha>) to stay put across pushes
# If you run it from a private fork, that package is private too — `docker login ghcr.io` once before the first pull. See docs/deploy.md.

# ── optional: sensible defaults shown; override only if needed ────────
SLACKLINE_PORT=8790                                  # API + install page port
SLACKLINE_RETAIN_DAYS=7                              # rolling message window (not an archive); older messages pruned
PGUSER=slackline
PGDATABASE=slackline
PG_EXPOSE=5440                                       # host port for Postgres (container is always 5432)
# SLACKLINE_BLOB_DIR is set to /app/blobs inside the container; override only for a bare-node run

# ── Slack app (bot) credentials — NOT read by docker-compose.yml ──────
# api/ingest never see these two vars in the Docker deploy: app credentials there are
# provisioned at runtime via `POST /apps` (see SUBSCRIBER_GUIDE.md) and stored in Postgres,
# not passed as env. These only apply to a bare `node standalone.mjs` run (the README's standalone mode).
# Both required together (neither works alone); app creds win over a user token for the same org.
# SLACKLINE_APP_TOKEN=xapp-...                        # opens the Socket Mode connection
# SLACKLINE_BOT_TOKEN=xoxb-...                        # Web API calls (chat.postMessage, etc)
